OPENAI_API_KEY=sk-...
ORACLE_DSN=localhost:1521/ORCL
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password

# MCP (mcp_servers.yaml 참고)
FAB_MCP_URL=http://localhost:8100/mcp
CEERIA_MCP_URL=http://localhost:8200/mcp
COMPANY_MCP_ENABLED=false
COMPANY_LINE_MCP_URL=https://mcp.fab.example.com/line/mcp
COMPANY_QUALITY_MCP_URL=https://mcp.fab.example.com/quality/mcp
COMPANY_MCP_TOKEN=
MCP_REFRESH_SEC=60

# 사용자 식별 — 회사 SSO 게이트웨이가 넣는 헤더 이름 (헤더가 없으면 DEV_USER_* 로 처리)
USER_ID_HEADER=X-User-Id
USER_NAME_HEADER=X-User-Name
USER_DEPT_HEADER=X-User-Dept
DEV_USER_ID=dev.user
DEV_USER_NAME=개발 사용자
# 회사 사용자 API (선택) — {user_id} 자리에 사번/계정이 들어간다. 응답 JSON 의 name/dept/email 사용
USER_INFO_URL=
USER_INFO_TOKEN=

# 사용자 메모리 (대화 끝날 때마다 md 갱신 — 턴당 gpt-4o-mini 1회 호출)
MEMORY_ENABLED=1
MEMORY_MODEL=gpt-4o-mini
MEMORY_MAX_CHARS=3000
USER_DB_PATH=
